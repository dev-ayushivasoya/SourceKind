# ---------- App ----------
PORT=3000
# Public URL of the app. Must be reachable by PayPal for webhooks (Render URL or an ngrok URL).
BASE_URL=http://localhost:3000
APP_NAME=SourceKind
DATA_DIR=./data

# ---------- PayPal (sandbox) ----------
# https://developer.paypal.com/dashboard/applications/sandbox  -> your app -> Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard -> your app -> Webhooks -> your webhook URL -> Webhook ID
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Used by "Login with PayPal" (maintainer claim). Sandbox host:
PAYPAL_WEB=https://www.sandbox.paypal.com
# Optional: reuse plans created earlier, e.g. {"5":"P-xxx","10":"P-yyy"}. Otherwise they are created on first use.
PAYPAL_PLAN_IDS=

# ---------- AI (optional but recommended) ----------
# Without a key the app falls back to rule-based explanations and a rule-based agent.
# Use an Anthropic key here, or set OPENROUTER_API_KEY for an OpenRouter key.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# For OpenRouter, use a provider/model id, e.g. anthropic/claude-sonnet-5.5.
# Do not put an API URL in LLM_MODEL.

# ---------- GitHub ----------
# Optional token: raises the GitHub API rate limit from 60/hour to 5000/hour. No scopes needed.
GITHUB_TOKEN=
# Optional GitHub OAuth app for maintainer verification (callback: BASE_URL/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Behaviour ----------
# true = a maintainer can claim without GitHub OAuth (sandbox demo only!). Set false for real verification.
CLAIM_DEMO_MODE=true
# true = shows the "run next cycle now" button (sandbox demo only: a real cycle happens monthly via PayPal)
DEV_TOOLS=true
MIN_PAYOUT=1.00
MAX_PACKAGES=20
CLAIM_EXPIRY_DAYS=30
# Share of each cycle kept by the platform (0 = none)
PLATFORM_FEE_PCT=0
# NEVER true in production. Only for local webhook simulation.
SKIP_WEBHOOK_VERIFY=false

   # ---------- Login page (GitHub sign-in) ----------
   LOGIN_GITHUB_CLIENT_ID=
   LOGIN_GITHUB_CLIENT_SECRET=
   LOGIN_GITHUB_CALLBACK_URL=http://localhost:3000/auth/login/github/callback